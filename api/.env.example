# Copy to api/.env before `docker compose up --build`:
#
#   cp api/.env.example api/.env
#
# Nothing here has a default in app/core/config.py, so the API will not start
# until every value below is filled in.

# --- Database -----------------------------------------------------------
# Matches the postgres service in docker-compose.yml. Change both together.
DATABASE_URL=postgresql+psycopg2://mcp:mcp@postgres:5432/multicloud

# --- Queue --------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Auth ---------------------------------------------------------------
# Any long random string. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Cloud credential encryption ----------------------------------------
# Encrypts the cloud keys users hand over, before they reach Postgres.
# Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this makes every stored credential undecryptable, so keep it.
FERNET_KEY=

# --- Provisioning limits ------------------------------------------------
# Where the terraform modules and per-tenant workspaces live inside the
# container; docker-compose mounts ./terraform there.
TERRAFORM_ROOT=/terraform
# One live resource per provider per user, destroyed after this many hours.
MAX_RESOURCES_PER_PROVIDER=1
AUTO_DESTROY_HOURS=24
